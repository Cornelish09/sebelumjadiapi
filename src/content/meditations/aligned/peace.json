{
  "id": "peace",
  "label": "01 — PEACE",
  "title": "Sebelum Semuanya Berubah",
  "theme": "Why It Matters",
  "intro": "Dengarkan kehidupan yang sering luput dari perhatian. Sebelum kita membicarakan api, mari mengenal apa yang masih hidup di dalam hutan.",
  "audioCandidatePath": "/assets/audio/meditations/peace/peace audio.mp3",
  "audioContentsVerified": true,
  "timingStatus": "AUTO_ALIGNED",
  "cues": [
    {
      "id": "peace-001",
      "start": 4.72,
      "end": 5.5,
      "text": "Pernah nggak..."
    },
    {
      "id": "peace-002",
      "start": 5.5,
      "end": 8.76,
      "text": "Kamu benar-benar berhenti sebentar Hanya untuk"
    },
    {
      "id": "peace-003",
      "start": 8.76,
      "end": 10.0,
      "text": "mendengarkan suara alam"
    },
    {
      "id": "peace-004",
      "start": 10.0,
      "end": 12.12,
      "text": "Bukan suara kendaraan yang lewat"
    },
    {
      "id": "peace-005",
      "start": 12.12,
      "end": 14.78,
      "text": "Bukan notifikasi yang terus berdatangan"
    },
    {
      "id": "peace-006",
      "start": 14.78,
      "end": 18.46,
      "text": "Tapi sesuatu yang selama ini mungkin jarang kita"
    },
    {
      "id": "peace-007",
      "start": 18.46,
      "end": 19.04,
      "text": "perhatikan"
    },
    {
      "id": "peace-008",
      "start": 19.04,
      "end": 21.46,
      "text": "Suara angin yang menyentuh dedaunan"
    },
    {
      "id": "peace-009",
      "start": 21.46,
      "end": 23.78,
      "text": "Burung-burung yang saling memanggil"
    },
    {
      "id": "peace-010",
      "start": 23.78,
      "end": 26.24,
      "text": "Dan serangga-serangga kecil yang diam-diam"
    },
    {
      "id": "peace-011",
      "start": 26.24,
      "end": 27.1,
      "text": "mengisi keheningan"
    },
    {
      "id": "peace-012",
      "start": 27.1,
      "end": 28.42,
      "text": "Coba bayangkan"
    },
    {
      "id": "peace-013",
      "start": 28.42,
      "end": 30.74,
      "text": "Sekarang kamu sedang berdiri di tengah"
    },
    {
      "id": "peace-014",
      "start": 30.74,
      "end": 32.64,
      "text": "hutan pada suatu pagi."
    },
    {
      "id": "peace-015",
      "start": 32.7,
      "end": 34.88,
      "text": "Cahaya matahari perlahan menembus celah"
    },
    {
      "id": "peace-016",
      "start": 34.88,
      "end": 35.48,
      "text": "pepohonan."
    },
    {
      "id": "peace-017",
      "start": 35.88,
      "end": 38.88,
      "text": "Udara terasa sejuk, tanah masih lembap setelah"
    },
    {
      "id": "peace-018",
      "start": 38.88,
      "end": 39.52,
      "text": "hujan semalam."
    },
    {
      "id": "peace-019",
      "start": 39.84,
      "end": 40.8,
      "text": "Tenang sekali ya."
    },
    {
      "id": "peace-020",
      "start": 41.26,
      "end": 44.52,
      "text": "Tapi, tahu nggak, hutan sebenarnya nggak pernah"
    },
    {
      "id": "peace-021",
      "start": 44.52,
      "end": 45.4,
      "text": "benar-benar diam."
    },
    {
      "id": "peace-022",
      "start": 45.84,
      "end": 49.16,
      "text": "Di balik setiap daun, setiap akar, dan setiap"
    },
    {
      "id": "peace-023",
      "start": 49.16,
      "end": 51.9,
      "text": "batang pohon, ada kehidupan yang terus berjalan."
    },
    {
      "id": "peace-024",
      "start": 52.38,
      "end": 55.04,
      "text": "Ada burung yang mencari makan, ada satwa yang"
    },
    {
      "id": "peace-025",
      "start": 55.04,
      "end": 57.44,
      "text": "menemukan tempat berlindung, ada akar yang"
    },
    {
      "id": "peace-026",
      "start": 57.44,
      "end": 59.96,
      "text": "membantu menjaga tanah dan air yang menjadi"
    },
    {
      "id": "peace-027",
      "start": 59.96,
      "end": 62.8,
      "text": "bagian penting dari kehidupan di sekitarnya dan"
    },
    {
      "id": "peace-028",
      "start": 62.8,
      "end": 64.9,
      "text": "semuanya saling terhubung."
    },
    {
      "id": "peace-029",
      "start": 64.96,
      "end": 67.66,
      "text": "Kadang kita melihat hutan hanya sebagai kumpulan"
    },
    {
      "id": "peace-030",
      "start": 67.66,
      "end": 71.36,
      "text": "pohon yang hijau dan indah padahal hutan adalah"
    },
    {
      "id": "peace-031",
      "start": 71.36,
      "end": 74.88,
      "text": "rumah, rumah bagi begitu banyak kehidupan juga"
    },
    {
      "id": "peace-032",
      "start": 74.88,
      "end": 77.22,
      "text": "bagian dari lingkungan yang mendukung kehidupan"
    },
    {
      "id": "peace-033",
      "start": 77.22,
      "end": 77.72,
      "text": "manusia."
    },
    {
      "id": "peace-034",
      "start": 77.94,
      "end": 80.76,
      "text": "Hutan membantu menjaga siklus air, menyimpan"
    },
    {
      "id": "peace-035",
      "start": 80.76,
      "end": 83.88,
      "text": "karbon dan menyediakan habitat bagi berbagai makhluk"
    },
    {
      "id": "peace-036",
      "start": 83.88,
      "end": 84.46,
      "text": "hidup."
    },
    {
      "id": "peace-037",
      "start": 84.46,
      "end": 86.78,
      "text": "Bayangkan, berapa banyak kehidupan yang"
    },
    {
      "id": "peace-038",
      "start": 86.78,
      "end": 89.38,
      "text": "bergantung pada satu lingkungan yang selama ini"
    },
    {
      "id": "peace-039",
      "start": 89.38,
      "end": 91.04,
      "text": "mungkin kita anggap biasa saja."
    },
    {
      "id": "peace-040",
      "start": 91.2,
      "end": 93.74,
      "text": "Kita mungkin nggak bisa mendengar setiap suara di"
    },
    {
      "id": "peace-041",
      "start": 93.74,
      "end": 94.26,
      "text": "dalamnya."
    },
    {
      "id": "peace-042",
      "start": 94.54,
      "end": 96.42,
      "text": "Nggak bisa melihat setiap kehidupan yang"
    },
    {
      "id": "peace-043",
      "start": 96.42,
      "end": 97.1,
      "text": "tersembunyi."
    },
    {
      "id": "peace-044",
      "start": 97.38,
      "end": 99.32,
      "text": "Tapi bukan berarti semuanya tidak ada."
    },
    {
      "id": "peace-045",
      "start": 99.8,
      "end": 102.84,
      "text": "Jadi, sebelum cerita ini berlanjut, sebelum kita"
    },
    {
      "id": "peace-046",
      "start": 102.84,
      "end": 106.6,
      "text": "berbicara tentang api, asap, kehilangan, coba"
    },
    {
      "id": "peace-047",
      "start": 106.6,
      "end": 109.46,
      "text": "luangkan satu momen untuk mengingat bahwa sebelum"
    },
    {
      "id": "peace-048",
      "start": 109.46,
      "end": 111.56,
      "text": "api muncul, ada kehidupan."
    },
    {
      "id": "peace-049",
      "start": 111.56,
      "end": 114.36,
      "text": "dan kehidupan itu layak kita jaga."
    }
  ],
